# Supabase project → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Temporary sender. Resend delivers onboarding@resend.dev only to the Resend account owner.
RESEND_API_KEY=re_...
EMAIL_FROM=Support Center <onboarding@resend.dev>
CRON_SECRET=generate-a-long-random-string
NEXT_PUBLIC_APP_URL=https://support-crm-emad25.vercel.app
