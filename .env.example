# Supabase project → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Ticket email. Prefer SMTP so the message lands in the recipient's Gmail or Outlook inbox.
# In Vercel, save these as Secret for Production:
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_FROM
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587. SMTP_PASSWORD is a Google app password.
# Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587, with Authenticated SMTP enabled.
# Port 587 uses STARTTLS. Port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional. When SMTP is configured and this is empty, the sender is SMTP_USER.
# EMAIL_FROM=Support Center <you@gmail.com>
EMAIL_FROM=

# Used only when SMTP_HOST, SMTP_USER, and SMTP_PASSWORD are not all set.
# onboarding@resend.dev delivers only to the Resend account owner.
RESEND_API_KEY=
CRON_SECRET=generate-a-long-random-string
NEXT_PUBLIC_APP_URL=https://support-crm-emad25.vercel.app
